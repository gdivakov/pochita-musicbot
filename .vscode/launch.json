{
  "version": "0.2.0",
  "configurations": [
    {
      // Local debugging
      "type": "node",
      "request": "launch",
      "name": "ArchieNailsBot debug",
      "runtimeExecutable": "nodemon",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/src/index.js",
      "console": "integratedTerminal",
      "runtimeArgs": [
        "--inspect=9229"
      ],
      "restart": true,
      "env": {
        "NODE_ENV": "development"
      }
    },
    // {
    //   "type": "node",
